<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Apex &mdash; Documentation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <%- include('partials/header', { user }) %>
  <div class="container">
    <h1 class="mb-3">Documentation</h1>
    <p class="text-muted">
      Look up every delivery doc for a Change Order, across every repo you have access to.
    </p>

    <div class="row g-2 mb-3">
      <div class="col-md-4">
        <label for="co-input" class="form-label">Change Order number</label>
        <input type="text" id="co-input" class="form-control" placeholder="C12345678" maxlength="9">
        <div class="form-text">Format: <code>C</code> followed by 8 digits.</div>
      </div>
      <div class="col-md-2 align-self-end">
        <button id="search-btn" type="button" class="btn btn-primary w-100">Search</button>
      </div>
    </div>

    <div id="search-error" class="alert alert-danger d-none"></div>

    <table class="table table-hover align-middle d-none" id="results-table">
      <thead>
        <tr>
          <th>Repo</th>
          <th>Document</th>
          <th>Last updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="result-rows"></tbody>
    </table>

    <div id="document-viewer" class="card d-none">
      <div class="card-body">
        <h5 class="card-title" id="document-viewer-title"></h5>
        <div id="document-viewer-body" class="border rounded p-3 bg-light"></div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/dom-utils.js"></script>
  <script src="/js/nav.js"></script>
  <script src="/js/markdown-utils.js"></script>
  <script src="/js/documents-search.js"></script>
</body>
</html>
