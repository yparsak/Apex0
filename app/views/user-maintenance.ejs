<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Apex &mdash; User maintenance</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body data-user-id="<%= userId %>">
  <%- include('partials/header', { user }) %>
  <div class="container">
    <p><a href="/admin">&larr; Back to user administration</a></p>
    <h1 class="mb-1">User maintenance</h1>
    <p class="text-muted" id="user-heading">Loading&hellip;</p>

    <div id="maintenance-error" class="alert alert-danger d-none"></div>
    <div id="maintenance-success" class="alert alert-success d-none"></div>

    <h2 class="h4">Initials</h2>
    <p class="text-muted">Used to name this user's branches, e.g. <code>dev/{initials}-{CO}-{n}</code>.</p>
    <div class="row g-2 mb-3">
      <div class="col-md-3">
        <input type="text" id="initials-input" class="form-control" maxlength="10">
      </div>
      <div class="col-auto">
        <button id="save-initials-btn" type="button" class="btn btn-outline-primary">Save</button>
      </div>
    </div>

    <h2 class="h4 mt-5">Grant repo-group access</h2>
    <div class="row g-2 mb-3">
      <div class="col-md-4">
        <label for="grant-repo-group-select" class="form-label">Repo group</label>
        <select id="grant-repo-group-select" class="form-select">
          <option value="">Loading&hellip;</option>
        </select>
      </div>
      <div class="col-md-2 align-self-end">
        <button id="grant-btn" type="button" class="btn btn-primary w-100">Grant</button>
      </div>
    </div>

    <h2 class="h4 mt-5">Current access</h2>
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Org</th>
          <th>Repo group</th>
          <th>Granted</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="permission-rows">
        <tr><td colspan="4" class="text-muted">Loading&hellip;</td></tr>
      </tbody>
    </table>
  </div>
  <script src="/js/api-client.js"></script>
  <script src="/js/dom-utils.js"></script>
  <script src="/js/nav.js"></script>
  <script src="/js/user-maintenance.js"></script>
</body>
</html>
