<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Apex &mdash; Documents</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body data-repo-id="<%= repoId %>">
  <%- include('partials/header', { user }) %>
  <div class="container">
    <p>
      <a href="/repos"><span>&larr; Back to repositories</span></a>
      &nbsp;&middot;&nbsp;
      <a href="/repos/<%= repoId %>/branches">Branches</a>
    </p>
    <h1 class="mb-3">Documents</h1>
    <p class="text-muted">
      Requirements log and Spec/Communication Protocol docs Apex has generated for this repo.
      These are no longer pushed to the repo automatically &mdash; download a file if you want to add it yourself.
    </p>

    <div id="documents-error" class="alert alert-danger d-none"></div>

    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Document</th>
          <th>CO</th>
          <th>Last updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="document-rows">
        <tr><td colspan="4" class="text-muted">Loading&hellip;</td></tr>
      </tbody>
    </table>

    <div id="document-viewer" class="card d-none">
      <div class="card-body">
        <h5 class="card-title" id="document-viewer-title"></h5>
        <div id="document-viewer-body" class="border rounded p-3 bg-light"></div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/dom-utils.js"></script>
  <script src="/js/nav.js"></script>
  <script src="/js/markdown-utils.js"></script>
  <script src="/js/documents.js"></script>
</body>
</html>
